          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(round(sum(seconds) / 3600.0, 1), 0) FROM v_plays WHERE $__timeFilter(played_at)"
        }
      ],
      "description": "Data-export plays count the time actually played; recorded plays count the song's length (Spotify only lists plays of 30 s or more).",
