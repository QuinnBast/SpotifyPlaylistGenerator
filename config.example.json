{
  "api": {
    "clientId": "YourClientId",
    "clientSecret": "YourClientSecret",
    "redirectUri": "http://127.0.0.1:9123",
    "cachePath": "./cache",
    "callbackPort": 9123
  },
  "login": {
    "refreshTokenLifetimeDays": 180,
    "warningDaysBeforeExpiry": 14,
    "reminderIntervalHours": 24
  },
  "credentials": {
    "username": "YourUsername"
  },
  "listeningHistory": {
    "enabled": false,
    "databaseUrl": "postgresql://spotify:your-password@your-postgres-host:5432/spotify",
    "grafanaPassword": "",
    "timeZone": "UTC",
    "pollMinutes": 15
  },
  "notifications": {
    "discord": {
      "enabled": false,
      "webhookUrl": "https://discord.com/api/webhooks/your-webhook",
      "mention": "<@your-discord-user-id>"
    },
    "ntfy": {
      "enabled": false,
      "url": "https://ntfy.sh/your-topic-here"
    }
  },
  "generator": {
    "recurring": true,
    "cadenceHours": 24,
    "recentlyAdded": {
      "enabled": true,
      "playlistName": "Most Recently Starred",
      "numberOfSongs": 50
    },
    "mostPlayedLongTerm": {
      "enabled": true,
      "playlistName": "Top songs - 1 Year",
      "numberOfSongs": 100
    },
    "mostPlayedMediumTerm": {
      "enabled": true,
      "playlistName": "Top songs - 6 months",
      "numberOfSongs": 50
    },
    "mostPlayedShortTerm": {
      "enabled": true,
      "playlistName": "Top songs - 4 weeks",
      "numberOfSongs": 20
    },
    "dailyShuffle": {
      "enabled": true,
      "playlistName": "Daily Shuffle",
      "numberOfSongs": 25
    },
    "forgottenFavorites": {
      "enabled": true,
      "playlistName": "Forgotten Favourites",
      "numberOfSongs": 30,
      "minDaysSinceLiked": 365
    }
  }
}
